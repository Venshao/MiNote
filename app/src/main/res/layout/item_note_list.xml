<?xml version="1.0" encoding="utf-8"?>
<!-- 对齐官方 common_note_item_list：左文右图 / 标题·摘要·时间·置顶 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/note_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/list_item_margin_bottom"
    android:background="@drawable/bg_note_item"
    android:foreground="?android:attr/selectableItemBackground"
    android:paddingStart="@dimen/list_item_content_margin_start"
    android:paddingTop="@dimen/list_item_content_margin_top"
    android:paddingEnd="@dimen/list_item_content_margin_start"
    android:paddingBottom="@dimen/list_item_content_margin_bottom">

    <LinearLayout
        android:id="@+id/note_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/note_text_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/note_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/note_list_title"
                    android:textSize="@dimen/list_item_primary_text_size"
                    android:textStyle="bold"
                    tools:text="标题" />

                <ImageView
                    android:id="@+id/note_stick"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:src="@android:drawable/btn_star_big_on"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/note_snippet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:textColor="@color/note_list_body"
                android:textSize="@dimen/list_item_secondary_text_size"
                tools:text="正文摘要" />

            <TextView
                android:id="@+id/note_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/note_list_meta"
                android:textSize="@dimen/list_item_tertiary_text_size"
                tools:text="今天 12:00" />
        </LinearLayout>

        <ImageView
            android:id="@+id/note_image"
            android:layout_width="@dimen/list_item_image_size"
            android:layout_height="@dimen/list_item_image_size"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="@dimen/list_item_image_margin_end"
            android:background="@drawable/bg_note_thumb"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/note_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_note_check"
        android:visibility="gone">

        <ImageView
            android:id="@+id/note_check_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_note_check"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
