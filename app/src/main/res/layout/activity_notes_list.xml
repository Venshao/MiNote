<?xml version="1.0" encoding="utf-8"?>
<!--
  对齐官方 NestedHeaderLayout 折叠：
  - 大标题/计数/搜索随滚动折叠
  - 右上角导入导出、切换视图固定置顶，不被 Toolbar 遮挡
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_background"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:liftOnScroll="false"
        app:liftOnScrollColor="@color/app_background">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/app_background"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:minHeight="@dimen/notes_header_collapsed_height"
            app:contentScrim="@color/app_background"
            app:statusBarScrim="@color/app_background"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:titleEnabled="false">

            <!-- 可折叠内容：不含右上角按钮，避免被 pin Toolbar 盖住 -->
            <LinearLayout
                android:id="@+id/header_expanded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.65">

                <TextView
                    android:id="@+id/title_notes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="96dp"
                    android:letterSpacing="-0.02"
                    android:text="笔记"
                    android:textColor="@color/note_list_title"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/notes_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="96dp"
                    android:textColor="@color/note_list_meta"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_search_field"
                    android:hint="搜索便签内容或标题..."
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/note_list_title"
                    android:textColorHint="@color/note_list_meta"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 透明 pin 条：仅承载折叠后的小标题，不挡图标 -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar_collapsed"
                android:layout_width="match_parent"
                android:layout_height="@dimen/notes_header_collapsed_height"
                android:background="@android:color/transparent"
                app:contentInsetStart="20dp"
                app:contentInsetEnd="96dp"
                app:layout_collapseMode="pin">

                <TextView
                    android:id="@+id/title_notes_collapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0"
                    android:text="笔记"
                    android:textColor="@color/note_list_title"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 右上角操作：叠在 AppBar 之上，始终可见（对齐原 Compose 圆形灰底图标） -->
    <LinearLayout
        android:id="@+id/header_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btn_sync"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_header_icon"
            android:contentDescription="云同步"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_import_export" />

        <ImageButton
            android:id="@+id/btn_toggle_layout"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_header_icon"
            android:contentDescription="切换视图"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_view_list" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/notes_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/common_two_column_recycler_horizontal_padding"
        android:paddingEnd="@dimen/common_two_column_recycler_horizontal_padding"
        android:paddingBottom="88dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <TextView
        android:id="@+id/empty_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:text="写下第一条随心记便签吧！"
        android:textColor="@color/note_list_empty"
        android:textSize="16sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/fab_add"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_fab_add"
        android:contentDescription="新增便签"
        android:elevation="4dp"
        android:src="@android:drawable/ic_input_add"
        android:tint="@android:color/white" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
